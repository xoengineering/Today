#!/usr/bin/env swift
// script/icon-sky: draw the app icon's sky layer, App/Today.icon/Assets/sky.png.
//
// The layer is soft patches of the sunset palette over the icon's linear fill. SVG gradients with fading stops come out
// with hard edges from every rasterizer that touches an icon, so the patches are drawn here with CoreGraphics instead.
// Run it after changing a patch, then build. The PNG is committed, so the build never depends on this script.

import AppKit

let repositoryRoot = URL(fileURLWithPath: CommandLine.arguments[0]).deletingLastPathComponent().appendingPathComponent("..")
FileManager.default.changeCurrentDirectoryPath(repositoryRoot.path)

// Each patch is a radial gradient from a color to its transparent self, stretched and turned into an ellipse.
// Coordinates are in CoreGraphics space, with the origin at the bottom left.
struct Patch {
  let center: CGPoint
  let radii: CGSize
  let rotation: CGFloat
  let color: (red: CGFloat, green: CGFloat, blue: CGFloat)
  let alpha: CGFloat
}

let patches = [
  Patch(center: CGPoint(x: 300, y: 844), radii: CGSize(width: 620, height: 420), rotation: 0, color: (1.00, 0.85, 0.66), alpha: 0.95),
  Patch(center: CGPoint(x: 820, y: 604), radii: CGSize(width: 560, height: 380), rotation: 20, color: (0.97, 0.65, 0.77), alpha: 0.85),
  Patch(center: CGPoint(x: 240, y: 144), radii: CGSize(width: 640, height: 400), rotation: -15, color: (0.73, 0.66, 0.95), alpha: 0.90),
  Patch(center: CGPoint(x: 760, y: 124), radii: CGSize(width: 520, height: 360), rotation: 35, color: (1.00, 0.71, 0.69), alpha: 0.70),
]

let size = 1024
let bitmap = NSBitmapImageRep(
  bitmapDataPlanes: nil, pixelsWide: size, pixelsHigh: size, bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
  isPlanar: false, colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
let context = NSGraphicsContext(bitmapImageRep: bitmap)!.cgContext
let colorSpace = CGColorSpace(name: CGColorSpace.sRGB)!

for patch in patches {
  context.saveGState()
  context.translateBy(x: patch.center.x, y: patch.center.y)
  context.rotate(by: patch.rotation * .pi / 180)
  context.scaleBy(x: patch.radii.width, y: patch.radii.height)
  let colors = [
    CGColor(colorSpace: colorSpace, components: [patch.color.red, patch.color.green, patch.color.blue, patch.alpha])!,
    CGColor(colorSpace: colorSpace, components: [patch.color.red, patch.color.green, patch.color.blue, 0])!,
  ] as CFArray
  let gradient = CGGradient(colorsSpace: colorSpace, colors: colors, locations: [0, 1])!
  context.drawRadialGradient(gradient, startCenter: .zero, startRadius: 0, endCenter: .zero, endRadius: 1, options: [])
  context.restoreGState()
}

let destination = URL(fileURLWithPath: "App/Today.icon/Assets/sky.png")
try bitmap.representation(using: .png, properties: [:])!.write(to: destination)
print("Wrote \(destination.path)")
